---
import SectionHeader from '@/components/ui/SectionHeader.astro';
import Icon from '@/components/ui/Icon.astro';
import { focusAreas } from '@/data/content';

interface Props {
  index?: string;
}
const { index = '01' } = Astro.props;
---

<section class="section theme-light focus" aria-labelledby="focus-title">
  <div class="container">
    <SectionHeader
      id="focus-title"
      index={index}
      eyebrow="What we do"
      title="Three disciplines, <em>one measurement chain.</em>"
      lead="From the electrode to the screen, we work across electrochemistry, sensing and electronics, so every instrument is designed as a whole."
      align="split"
    />

    <div class="focus__grid" data-reveal-stagger="90">
      {
        focusAreas.map((a, i) => (
          <article class="focus__card card" id={a.id} data-reveal>
            <div class="focus__top">
              <span class="icon-tile">
                <Icon name={a.icon} />
              </span>
              <span class="focus__n mono">0{i + 1}</span>
            </div>
            <h3 class="h3 focus__title">{a.title}</h3>
            <p class="focus__text">{a.text}</p>
            <ul role="list" class="focus__points">
              {a.points.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .focus__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-m);
  }

  .focus__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    padding: clamp(1.5rem, 1.1rem + 1.2vw, 2.25rem);
    overflow: hidden;
    transition:
      transform 0.35s var(--ease-out),
      box-shadow 0.35s var(--ease-out),
      border-color 0.35s;
  }

  .focus__card::after {
    content: '';
    position: absolute;
    inset: auto -30% -60% auto;
    width: 260px;
    height: 260px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(65 105 225 / 0.12), transparent);
    pointer-events: none;
  }

  .focus__card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--accent) 35%, transparent);
    box-shadow: 0 1px 2px rgb(11 21 51 / 0.05), 0 30px 60px -30px rgb(28 47 107 / 0.45);
  }

  .focus__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-2xs);
  }

  .focus__n {
    font-size: var(--step--1);
    color: var(--fg-subtle);
  }

  .focus__text {
    color: var(--fg-muted);
  }

  .focus__points {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: var(--space-xs);
  }

  .focus__points li {
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent-text);
    font-size: 0.82rem;
    font-weight: 500;
  }

  @media (max-width: 960px) {
    .focus__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
