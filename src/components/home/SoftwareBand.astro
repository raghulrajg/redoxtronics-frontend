---
import Icon from '@/components/ui/Icon.astro';
import SoftwareArt from '@/components/illustrations/SoftwareArt.astro';
import { site } from '@/config';
import { href, mailto } from '@/lib/url';

interface Props {
  index?: string;
}
const { index = '03' } = Astro.props;

const features = [
  'Set up and run measurements',
  'Watch results as they are recorded',
  'Export your data for analysis',
];
---

<section class="section theme-light sb" aria-labelledby="software-title">
  <div class="container sb__layout">
    <div class="sb__copy">
      <p class="eyebrow" data-reveal><span class="num">{index}</span> Software</p>
      <h2 id="software-title" class="h2" data-reveal style="--reveal-delay: 60ms">
        Software for our instruments, <span class="grad">coming soon.</span>
      </h2>
      <p class="lead" data-reveal style="--reveal-delay: 120ms">
        We also develop the software that runs our instruments. Installers will be published in the
        software downloads section as soon as they are released.
      </p>
      <ul role="list" class="check-list sb__list" data-reveal style="--reveal-delay: 160ms">
        {features.map((f) => <li>{f}</li>)}
      </ul>
      <div class="btn-row" data-reveal style="--reveal-delay: 200ms">
        <a class="btn btn--primary" href={href('/software/')}>
          <Icon name="download" strokeWidth={2} />
          Software downloads
        </a>
        <a class="btn btn--secondary" href={mailto(site.email, 'Notify me about Redoxtronics software downloads')}>
          <Icon name="bell" strokeWidth={2} />
          Get notified
        </a>
      </div>
    </div>
    <div class="sb__visual" data-reveal style="--reveal-delay: 120ms">
      <SoftwareArt />
      <span class="badge badge--soon sb__badge">
        <Icon name="clock" strokeWidth={2} />
        Downloads coming soon
      </span>
    </div>
  </div>
</section>

<style>
  .sb__layout {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(2.5rem, 1rem + 5vw, 6rem);
  }

  .sb__copy {
    display: grid;
    justify-items: start;
    gap: var(--space-m);
  }

  .sb__copy .h2 {
    max-width: 16ch;
  }

  .sb__list {
    margin-block: var(--space-2xs);
  }

  .sb__visual {
    position: relative;
  }

  .sb__visual :global(.ill) {
    border-radius: var(--radius-l);
    box-shadow: 0 40px 80px -40px rgb(28 47 107 / 0.6);
  }

  .sb__badge {
    position: absolute;
    top: -14px;
    right: 20px;
    background: #fff8e6;
    box-shadow: 0 10px 24px -12px rgb(180 83 9 / 0.45);
  }

  @media (max-width: 960px) {
    .sb__layout {
      grid-template-columns: 1fr;
    }
  }
</style>
