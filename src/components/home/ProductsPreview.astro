---
import SectionHeader from '@/components/ui/SectionHeader.astro';
import Icon from '@/components/ui/Icon.astro';
import WorkstationArt from '@/components/illustrations/WorkstationArt.astro';
import GasDetectorArt from '@/components/illustrations/GasDetectorArt.astro';
import { products, isComingSoon } from '@/data/products';
import { href } from '@/lib/url';

interface Props {
  index?: string;
}
const { index = '02' } = Astro.props;
---

<section class="section theme-dark products-preview" aria-labelledby="products-title">
  <div class="products-preview__bg bg-grid" aria-hidden="true"></div>
  <div class="container">
    <SectionHeader
      id="products-title"
      index={index}
      eyebrow="Products"
      title="Instruments, <em>developed in-house.</em>"
      lead="A portable electrochemical workstation and gas sensor detectors, each developed in two versions. Full specifications, photos and datasheets are coming soon."
      align="split"
    />

    <div class="pp__grid" data-reveal-stagger="110">
      {
        products.map((p) => {
          const pending = p.versions.filter(isComingSoon).length;
          return (
            <article class="pp__card" data-reveal>
              <a class="pp__media" href={href(`/products/#${p.slug}`)} tabindex="-1" aria-hidden="true">
                {p.illustration === 'workstation' ? <WorkstationArt /> : <GasDetectorArt />}
              </a>
              <div class="pp__body">
                <div class="pp__meta">
                  <span class="badge">
                    <Icon name="layers" strokeWidth={2} />
                    {p.versions.length} versions
                  </span>
                  {pending > 0 && (
                    <span class="badge badge--soon">
                      <Icon name="clock" strokeWidth={2} />
                      Details coming soon
                    </span>
                  )}
                </div>
                <h3 class="h3">{p.name}</h3>
                <p class="pp__text">{p.short}</p>
                <a class="text-link" href={href(`/products/#${p.slug}`)}>
                  View product
                  <Icon name="arrow-right" strokeWidth={2} />
                </a>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .products-preview {
    overflow: hidden;
    background:
      radial-gradient(50% 60% at 15% 0%, rgb(65 105 225 / 0.22), transparent 70%),
      var(--navy-900);
  }

  .products-preview__bg {
    position: absolute;
    inset: 0;
    mask-image: radial-gradient(70% 60% at 50% 0%, #000, transparent 80%);
    -webkit-mask-image: radial-gradient(70% 60% at 50% 0%, #000, transparent 80%);
    pointer-events: none;
  }

  .products-preview .container {
    position: relative;
  }

  .pp__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-l);
  }

  .pp__card {
    display: grid;
    align-content: start;
    gap: var(--space-m);
    padding: var(--space-s);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: linear-gradient(180deg, rgb(255 255 255 / 0.05), rgb(255 255 255 / 0.015));
    transition:
      border-color 0.3s,
      transform 0.35s var(--ease-out);
  }

  .pp__card:hover {
    border-color: rgb(152 175 246 / 0.35);
    transform: translateY(-4px);
  }

  .pp__media {
    display: block;
    border-radius: var(--radius-l);
    overflow: hidden;
  }

  .pp__body {
    display: grid;
    justify-items: start;
    gap: var(--space-xs);
    padding: 0 var(--space-s) var(--space-s);
  }

  .pp__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .pp__text {
    color: var(--fg-muted);
    margin-bottom: var(--space-2xs);
  }

  @media (max-width: 900px) {
    .pp__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
