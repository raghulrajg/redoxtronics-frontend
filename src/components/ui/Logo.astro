---
/**
 * Redoxtronics Technologies logo, built from the official logo
 * (original file: brand/redoxtronics-logo-original.webp):
 * - the DNA + circuit emblem (public/brand/redoxtronics-mark.webp, transparent)
 * - the two-colour wordmark "REDOX" (red) + "TRONICS" (blue) over "TECHNOLOGIES".
 *
 * The full logo, with its frame, is shown in the footer
 * (public/brand/redoxtronics-logo.webp).
 */
import { site } from '@/config';
import { href } from '@/lib/url';

interface Props {
  class?: string;
  showWordmark?: boolean;
  /** Height of the emblem in px. */
  size?: number;
}
const { class: className, showWordmark = true, size = 46 } = Astro.props;

/** Width / height of public/brand/redoxtronics-mark.webp. */
const MARK_RATIO = 420 / 520;
---

<span class:list={['logo', className]}>
  <img
    class="logo__mark"
    src={href('/brand/redoxtronics-mark.webp')}
    width={Math.round(size * MARK_RATIO)}
    height={size}
    alt={showWordmark ? '' : site.legalName}
    decoding="async"
  />
  {
    showWordmark && (
      <span class="logo__type">
        <span class="logo__name">
          <span class="logo__redox">REDOX</span>
          <span class="logo__tronics">TRONICS</span>
        </span>
        <span class="logo__sub">TECHNOLOGIES</span>
      </span>
    )
  }
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--fg);
  }

  .logo__mark {
    flex: none;
    filter: drop-shadow(0 6px 14px rgb(65 105 225 / 0.35));
  }

  .logo__type {
    display: grid;
    justify-items: center;
    line-height: 1;
  }

  .logo__name {
    display: flex;
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.005em;
  }

  /* Brand colours from the logo, brightened slightly for the dark header. */
  .logo__redox {
    color: #e2312e;
  }

  .logo__tronics {
    color: #3390d6;
  }

  .logo__sub {
    margin-top: 0.32rem;
    padding-left: 0.3em;
    font-family: var(--font-display);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.3em;
    color: #f4f7ff;
  }
</style>
