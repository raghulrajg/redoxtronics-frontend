---
/**
 * Redoxtronics logo.
 * Mark: the chemical equilibrium sign (⇌), the symbol of a reversible redox
 * reaction, in a royal-blue tile. Wordmark: "Redox" + "tronics".
 *
 * This is a placeholder brand mark. To use your official logo, replace the
 * <svg> below (and run `npm run assets` to refresh the favicons).
 */
interface Props {
  class?: string;
  showWordmark?: boolean;
  size?: number;
}
const { class: className, showWordmark = true, size = 36 } = Astro.props;
---

<span class:list={['logo', className]}>
  <svg
    class="logo__mark"
    width={size}
    height={size}
    viewBox="0 0 32 32"
    aria-hidden="true"
    focusable="false"
  >
    <path
      d="M8 12.5h15.5l-4.6-4.2"
      fill="none"
      stroke="#fff"
      stroke-width="2.4"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
    <path
      d="M24 19.5H8.5l4.6 4.2"
      fill="none"
      stroke="#fff"
      stroke-width="2.4"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
  {
    showWordmark && (
      <span class="logo__type">
        <span class="logo__name">
          Redox<span class="logo__name-b">tronics</span>
        </span>
        <span class="logo__sub">Electrochemical R&amp;D</span>
      </span>
    )
  }
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--fg);
  }

  .logo__mark {
    flex: none;
    border-radius: 28%;
    background: linear-gradient(145deg, #6188f3 0%, var(--royal-500) 45%, var(--royal-700) 100%);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.22),
      0 8px 18px -8px rgb(65 105 225 / 0.9);
  }

  .logo__type {
    display: grid;
    line-height: 1;
  }

  .logo__name {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .logo__name-b {
    font-weight: 500;
    color: var(--accent-text);
  }

  .logo__sub {
    margin-top: 0.32rem;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--fg-subtle);
  }
</style>
