---
/**
 * Illustration: a portable electrochemical workstation wired to a
 * three-electrode cell (working, reference and counter electrodes).
 * Replace with a product photo once available.
 */
import { cyclicVoltammogram, cvPath, type PlotBox } from '@/lib/voltammogram';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;

const screen: PlotBox = { x0: 78, x1: 204, y0: 158, y1: 226, eMin: -0.25, eMax: 0.65, iMin: -40, iMax: 40 };
const curve = cvPath(cyclicVoltammogram({ steps: 60 }), screen);

const electrodes = [
  { key: 'WE', x: 406, color: '#6a8aef' },
  { key: 'RE', x: 440, color: '#e8eeff' },
  { key: 'CE', x: 474, color: '#5ad1ff' },
];
const bubbles = [
  { x: 470, r: 2.2, begin: '0s' },
  { x: 479, r: 1.7, begin: '1.1s' },
  { x: 484, r: 2.5, begin: '2.2s' },
];
---

<svg
  class:list={['ill ws', className]}
  viewBox="0 0 560 380"
  role="img"
  aria-labelledby="ws-title"
>
  <title id="ws-title">Illustration of a portable electrochemical workstation connected to a three-electrode cell</title>
  <defs>
    <linearGradient id="ws-bg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#10235a"></stop>
      <stop offset="1" stop-color="#081436"></stop>
    </linearGradient>
    <pattern id="ws-grid" width="28" height="28" patternUnits="userSpaceOnUse">
      <path d="M28 0H0V28" fill="none" stroke="rgb(255 255 255 / 0.045)"></path>
    </pattern>
    <linearGradient id="ws-body" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#2546a0"></stop>
      <stop offset="1" stop-color="#132a66"></stop>
    </linearGradient>
    <linearGradient id="ws-liquid" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#4169e1" stop-opacity="0.32"></stop>
      <stop offset="1" stop-color="#4169e1" stop-opacity="0.55"></stop>
    </linearGradient>
    <linearGradient id="ws-rod" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#eef2ff"></stop>
      <stop offset="1" stop-color="#aebff0"></stop>
    </linearGradient>
    <radialGradient id="ws-knob" cx="0.35" cy="0.3" r="0.8">
      <stop offset="0" stop-color="#3d63cf"></stop>
      <stop offset="1" stop-color="#13275a"></stop>
    </radialGradient>
  </defs>

  <!-- Panel -->
  <rect x="0.5" y="0.5" width="559" height="379" rx="18" fill="url(#ws-bg)"></rect>
  <rect x="0.5" y="0.5" width="559" height="379" rx="18" fill="url(#ws-grid)"></rect>
  <rect x="0.5" y="0.5" width="559" height="379" rx="18" fill="none" stroke="rgb(152 175 246 / 0.28)"></rect>

  <!-- Cables (nested arcs from the instrument to each electrode) -->
  <g fill="none" stroke-width="3.2" stroke-linecap="round">
    <path d="M222 94C222 -4 474 -4 474 92" stroke="#5ad1ff"></path>
    <path d="M252 94C252 18 440 18 440 86" stroke="#e8eeff" stroke-opacity="0.9"></path>
    <path d="M282 94C282 40 406 40 406 92" stroke="#6a8aef"></path>
  </g>

  <!-- Instrument -->
  <rect x="40" y="104" width="264" height="190" rx="22" fill="url(#ws-body)" stroke="rgb(255 255 255 / 0.2)"></rect>
  <path d="M62 105.5H282" stroke="rgb(255 255 255 / 0.28)"></path>
  {
    [
      { x: 222, color: '#5ad1ff' },
      { x: 252, color: '#e8eeff' },
      { x: 282, color: '#6a8aef' },
    ].map((c) => (
      <g>
        <rect x={c.x - 9} y="92" width="18" height="14" rx="4" fill="#0a1638" stroke="rgb(255 255 255 / 0.3)" />
        <circle cx={c.x} cy="99" r="4" fill={c.color} />
      </g>
    ))
  }
  <rect x="54" y="118" width="236" height="162" rx="14" fill="#0a1840" stroke="rgb(255 255 255 / 0.08)"></rect>

  <!-- Screen -->
  <rect x="68" y="132" width="146" height="104" rx="8" fill="#050d29" stroke="rgb(111 149 255 / 0.5)"></rect>
  <text x="78" y="148" class="ill__label ill__label--cyan" font-size="8">CV · 50 mV/s</text>
  <rect x="186" y="140" width="14" height="8" rx="1.5" fill="none" stroke="#9fb0d8"></rect>
  <rect x="200" y="142.5" width="2" height="3" fill="#9fb0d8"></rect>
  <rect x="187.5" y="141.5" width="8" height="5" fill="#34d399"></rect>
  <g stroke="rgb(255 255 255 / 0.06)">
    <line x1="78" y1="175" x2="204" y2="175"></line>
    <line x1="78" y1="209" x2="204" y2="209"></line>
  </g>
  <line x1="78" y1="192" x2="204" y2="192" stroke="rgb(159 176 216 / 0.35)" stroke-dasharray="2 3"></line>
  <path d={curve} fill="rgb(90 209 255 / 0.1)" stroke="#5ad1ff" stroke-width="1.6" stroke-linejoin="round"></path>

  <!-- Controls -->
  <circle cx="276" cy="134" r="7" fill="#34d399" opacity="0.18"></circle>
  <circle cx="276" cy="134" r="3" fill="#34d399"></circle>
  <circle cx="252" cy="162" r="17" fill="url(#ws-knob)" stroke="rgb(255 255 255 / 0.28)"></circle>
  <line x1="252" y1="162" x2="252" y2="149" stroke="#c9d8ff" stroke-width="2" stroke-linecap="round"></line>
  <rect x="228" y="192" width="48" height="16" rx="8" fill="#2f52cc"></rect>
  <text x="252" y="203" text-anchor="middle" class="ill__label ill__label--strong" font-size="7.5">RUN</text>
  <rect x="228" y="214" width="48" height="16" rx="8" fill="#13275a" stroke="rgb(255 255 255 / 0.2)"></rect>
  <text x="252" y="225" text-anchor="middle" class="ill__label" font-size="7.5">STOP</text>
  <text x="68" y="264" class="ill__label ill__label--dim" letter-spacing="2.4">REDOXTRONICS</text>

  <!-- Cell: liquid, electrodes, then glass on top -->
  <path d="M374 196H506V306Q506 320 492 320H388Q374 320 374 306Z" fill="url(#ws-liquid)"></path>
  <line x1="374" y1="196" x2="506" y2="196" stroke="rgb(159 227 255 / 0.7)" stroke-width="1.5"></line>

  <!-- Working electrode (disk) -->
  <rect x="399" y="92" width="14" height="12" rx="3" fill="#6a8aef"></rect>
  <rect x="400" y="104" width="12" height="184" rx="3" fill="url(#ws-rod)"></rect>
  <rect x="402" y="283" width="8" height="5" rx="1" fill="#0b1533"></rect>

  <!-- Reference electrode (glass tube with frit) -->
  <rect x="434" y="86" width="12" height="12" rx="3" fill="#e8eeff"></rect>
  <rect x="436" y="98" width="8" height="184" rx="4" fill="rgb(255 255 255 / 0.12)" stroke="rgb(255 255 255 / 0.5)"></rect>
  <line x1="440" y1="100" x2="440" y2="264" stroke="#c7d2ee" stroke-width="1.4"></line>
  <rect x="436.5" y="274" width="7" height="7" rx="1.5" fill="#9fb0d8"></rect>

  <!-- Counter electrode (coiled wire) -->
  <rect x="467" y="92" width="14" height="12" rx="3" fill="#5ad1ff"></rect>
  <path
    d="M474 104V214l7 5-14 8 14 8-14 8 14 8-14 8 14 8-7 5"
    fill="none"
    stroke="#e8eeff"
    stroke-width="2"
    stroke-linejoin="round"
    stroke-linecap="round"></path>

  <!-- Bubbles at the counter electrode -->
  {
    bubbles.map((b) => (
      <circle cx={b.x} cy="272" r={b.r} fill="none" stroke="rgb(224 240 255 / 0.85)" stroke-width="1" opacity="0">
        <animate attributeName="cy" from="272" to="200" dur="3.3s" begin={b.begin} repeatCount="indefinite" />
        <animate
          attributeName="opacity"
          values="0;1;1;0"
          keyTimes="0;0.1;0.85;1"
          dur="3.3s"
          begin={b.begin}
          repeatCount="indefinite"
        />
      </circle>
    ))
  }

  <!-- Beaker glass -->
  <path
    d="M364 150H372V306Q372 322 388 322H492Q508 322 508 306V150H516"
    fill="none"
    stroke="rgb(223 230 253 / 0.6)"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
  <path d="M383 166V298" stroke="rgb(255 255 255 / 0.14)" stroke-width="3" stroke-linecap="round"></path>
  <g stroke="rgb(255 255 255 / 0.3)">
    <line x1="496" y1="222" x2="506" y2="222"></line>
    <line x1="500" y1="248" x2="506" y2="248"></line>
    <line x1="496" y1="274" x2="506" y2="274"></line>
  </g>

  <!-- Labels -->
  {
    electrodes.map((e) => (
      <text x={e.x} y="344" text-anchor="middle" class="ill__label ill__label--strong">
        {e.key}
      </text>
    ))
  }
  <text x="40" y="352" class="ill__label ill__label--dim">PORTABLE ELECTROCHEMICAL WORKSTATION · ILLUSTRATION</text>
</svg>
