---
/**
 * Illustration: a handheld gas sensor detector sensing gas molecules.
 * Replace with a product photo once available.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;

// Grille holes on the sensor head
const holes: [number, number][] = [];
for (const y of [72, 84, 96]) for (let k = 0; k < 6; k++) holes.push([245 + k * 14, y]);

// A deterministic sparkline for the display
const spark = Array.from({ length: 27 }, (_, k) => {
  const x = 228 + k * 4;
  const y = 210 - 4 * Math.sin(k * 0.55) - 2.5 * Math.sin(k * 1.7 + 1) - (k > 18 ? (k - 18) * 0.6 : 0);
  return `${k ? 'L' : 'M'}${x} ${y.toFixed(1)}`;
}).join('');

// Floating gas molecules: [x, y, kind, rotation, duration, dx, dy]
const molecules: [number, number, 'tri' | 'di', number, string, number, number][] = [
  [416, 66, 'tri', -18, '7s', 10, -14],
  [492, 128, 'di', 30, '6s', -8, -12],
  [432, 206, 'tri', 22, '8s', 12, -10],
  [506, 262, 'di', -35, '6.5s', -10, -14],
  [118, 34, 'di', 20, '7.5s', 10, -8],
];
---

<svg
  class:list={['ill gd', className]}
  viewBox="0 0 560 380"
  role="img"
  aria-labelledby="gd-title"
>
  <title id="gd-title">Illustration of a handheld gas sensor detector</title>
  <defs>
    <linearGradient id="gd-bg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#10235a"></stop>
      <stop offset="1" stop-color="#081436"></stop>
    </linearGradient>
    <pattern id="gd-grid" width="28" height="28" patternUnits="userSpaceOnUse">
      <path d="M28 0H0V28" fill="none" stroke="rgb(255 255 255 / 0.045)"></path>
    </pattern>
    <linearGradient id="gd-body" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#2a4caa"></stop>
      <stop offset="1" stop-color="#122862"></stop>
    </linearGradient>
  </defs>

  <!-- Panel -->
  <rect x="0.5" y="0.5" width="559" height="379" rx="18" fill="url(#gd-bg)"></rect>
  <rect x="0.5" y="0.5" width="559" height="379" rx="18" fill="url(#gd-grid)"></rect>
  <rect x="0.5" y="0.5" width="559" height="379" rx="18" fill="none" stroke="rgb(152 175 246 / 0.28)"></rect>

  <g transform="translate(0 -10)">
  <!-- Sensing waves from the sensor head (behind the device) -->
  {
    ['0s', '1.75s'].map((begin) => (
      <circle cx="280" cy="84" r="60" fill="none" stroke="#6a8aef" stroke-width="1.5" opacity="0">
        <animate attributeName="r" from="60" to="190" dur="3.5s" begin={begin} repeatCount="indefinite" />
        <animate attributeName="opacity" values="0.55;0" dur="3.5s" begin={begin} repeatCount="indefinite" />
      </circle>
    ))
  }
  <circle cx="280" cy="84" r="120" fill="none" stroke="rgb(106 138 239 / 0.18)" stroke-dasharray="3 6"></circle>

  <!-- Gas molecules -->
  {
    molecules.map(([x, y, kind, rot, dur, dx, dy]) => (
      <g transform={`translate(${x} ${y}) rotate(${rot})`}>
        <g>
          <animateTransform
            attributeName="transform"
            type="translate"
            values={`0 0; ${dx} ${dy}; 0 0`}
            dur={dur}
            repeatCount="indefinite"
          />
          {kind === 'tri' ? (
            <>
              <line x1="-15" y1="0" x2="15" y2="0" stroke="rgb(223 230 253 / 0.5)" stroke-width="2" />
              <circle cx="-15" cy="0" r="6" fill="#5ad1ff" />
              <circle cx="0" cy="0" r="8" fill="#98aff6" />
              <circle cx="15" cy="0" r="6" fill="#5ad1ff" />
            </>
          ) : (
            <>
              <line x1="-7" y1="0" x2="7" y2="0" stroke="rgb(223 230 253 / 0.5)" stroke-width="2" />
              <circle cx="-7" cy="0" r="6.5" fill="#6a8aef" />
              <circle cx="7" cy="0" r="6.5" fill="#c3d0fb" />
            </>
          )}
        </g>
      </g>
    ))
  }

  <!-- Detector body -->
  <rect x="189" y="122" width="10" height="124" rx="5" fill="#0a1840" stroke="rgb(255 255 255 / 0.12)"></rect>
  <rect x="361" y="122" width="10" height="124" rx="5" fill="#0a1840" stroke="rgb(255 255 255 / 0.12)"></rect>
  <rect x="196" y="36" width="168" height="308" rx="36" fill="url(#gd-body)" stroke="rgb(255 255 255 / 0.2)"></rect>
  <path d="M226 37.5H334" stroke="rgb(255 255 255 / 0.3)"></path>

  <!-- Sensor head -->
  <rect x="222" y="56" width="116" height="56" rx="20" fill="#0a1840" stroke="rgb(255 255 255 / 0.12)"></rect>
  {holes.map(([cx, cy]) => <circle cx={cx} cy={cy} r="3.2" fill="#040a1f" stroke="rgb(152 175 246 / 0.3)" />)}

  <!-- Display -->
  <rect x="216" y="128" width="128" height="96" rx="12" fill="#050d29" stroke="rgb(111 149 255 / 0.5)"></rect>
  <text x="228" y="146" class="ill__label ill__label--cyan" font-size="8">GAS · PPM</text>
  <rect x="300" y="137" width="32" height="13" rx="6.5" fill="rgb(52 211 153 / 0.16)" stroke="rgb(52 211 153 / 0.5)"></rect>
  <text x="316" y="146.5" text-anchor="middle" class="gd__ok">OK</text>
  <text x="228" y="188" class="gd__reading">24</text>
  <text x="274" y="188" class="ill__label">ppm</text>
  <path d={spark} fill="none" stroke="#5ad1ff" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round"></path>

  <!-- Status LEDs -->
  <circle cx="250" cy="246" r="10" fill="#34d399" opacity="0.18">
    <animate attributeName="opacity" values="0.18;0.04;0.18" dur="2.4s" repeatCount="indefinite"></animate>
  </circle>
  <circle cx="250" cy="246" r="5" fill="#34d399"></circle>
  <circle cx="280" cy="246" r="5" fill="#fbbf24" opacity="0.3"></circle>
  <circle cx="310" cy="246" r="5" fill="#f87171" opacity="0.3"></circle>

  <!-- Buttons -->
  <circle cx="246" cy="288" r="12" fill="#13275a" stroke="rgb(255 255 255 / 0.2)"></circle>
  <circle cx="314" cy="288" r="12" fill="#13275a" stroke="rgb(255 255 255 / 0.2)"></circle>
  <circle cx="280" cy="288" r="14" fill="#2f52cc" stroke="rgb(255 255 255 / 0.3)"></circle>
  <path d="M275 283.5a6.5 6.5 0 1 0 10 0M280 280.5v6" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round"></path>
  <text x="280" y="328" text-anchor="middle" class="ill__label ill__label--dim" letter-spacing="2.2">REDOXTRONICS</text>

  <!-- Callouts -->
  <g stroke="rgb(152 175 246 / 0.45)" fill="none">
    <path d="M222 84H150"></path>
    <path d="M216 176H150"></path>
    <path d="M240 246H150"></path>
  </g>
  <g fill="#98aff6">
    <circle cx="150" cy="84" r="2.5"></circle>
    <circle cx="150" cy="176" r="2.5"></circle>
    <circle cx="150" cy="246" r="2.5"></circle>
  </g>
  <text x="140" y="87.5" text-anchor="end" class="ill__label ill__label--strong">SENSOR</text>
  <text x="140" y="179.5" text-anchor="end" class="ill__label ill__label--strong">DISPLAY</text>
  <text x="140" y="249.5" text-anchor="end" class="ill__label ill__label--strong">STATUS</text>
  </g>
  <text x="40" y="356" class="ill__label ill__label--dim">GAS SENSOR DETECTOR · ILLUSTRATION</text>
</svg>

<style>
  .gd__reading {
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 600;
    letter-spacing: -0.02em;
    fill: #eef2ff;
  }

  .gd__ok {
    font-family: var(--font-mono);
    font-size: 7.5px;
    font-weight: 600;
    fill: #34d399;
  }
</style>
