---
/**
 * Illustration: desktop measurement software showing a live voltammogram
 * and the data table. A generic preview until real screenshots are available.
 */
import { cyclicVoltammogram, cvPath, scaler, type PlotBox } from '@/lib/voltammogram';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;

const box: PlotBox = { x0: 182, x1: 516, y0: 114, y1: 254, eMin: -0.25, eMax: 0.65, iMin: -40, iMax: 40 };
const { x, y } = scaler(box);
const points = cyclicVoltammogram({ steps: 80 });
const curve = cvPath(points, box);

// Three rows of "recorded data" taken from the computed curve.
const dt = 0.8 / 80 / 0.05; // potential step / scan rate (50 mV/s)
const rows = [52, 53, 54].map((k) => ({
  t: (k * dt).toFixed(2),
  e: points[k].e.toFixed(3),
  i: points[k].i.toFixed(2),
}));

const menu = ['Methods', 'Run', 'Data', 'Export', 'Settings'];
---

<svg
  class:list={['ill sw', className]}
  viewBox="0 0 560 380"
  role="img"
  aria-labelledby="sw-title"
>
  <title id="sw-title">Illustration of Redoxtronics measurement software plotting a voltammogram</title>
  <defs>
    <linearGradient id="sw-bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#2a4caa"></stop>
      <stop offset="1" stop-color="#0e1f4d"></stop>
    </linearGradient>
  </defs>

  <!-- Backdrop -->
  <rect x="0.5" y="0.5" width="559" height="379" rx="18" fill="url(#sw-bg)"></rect>
  <rect x="0.5" y="0.5" width="559" height="379" rx="18" fill="none" stroke="rgb(152 175 246 / 0.3)"></rect>

  <!-- Window -->
  <rect x="20" y="20" width="520" height="340" rx="12" fill="#0a1638" stroke="rgb(255 255 255 / 0.14)"></rect>
  <path d="M20 52H540" stroke="rgb(255 255 255 / 0.08)"></path>
  <circle cx="40" cy="36" r="4.5" fill="#f87171" opacity="0.85"></circle>
  <circle cx="56" cy="36" r="4.5" fill="#fbbf24" opacity="0.85"></circle>
  <circle cx="72" cy="36" r="4.5" fill="#34d399" opacity="0.85"></circle>
  <text x="280" y="39.5" text-anchor="middle" class="ill__label">Redoxtronics · Measurement</text>
  <text x="528" y="39.5" text-anchor="end" class="ill__label ill__label--dim">ILLUSTRATION</text>

  <!-- Sidebar -->
  <rect x="20.5" y="52.5" width="112" height="307" fill="rgb(255 255 255 / 0.02)"></rect>
  <path d="M132.5 52V360" stroke="rgb(255 255 255 / 0.08)"></path>
  {
    menu.map((label, k) => {
      const top = 66 + k * 28;
      const active = label === 'Run';
      return (
        <g>
          {active && <rect x="28" y={top} width="96" height="22" rx="6" fill="rgb(65 105 225 / 0.38)" />}
          <rect
            x="37"
            y={top + 7}
            width="8"
            height="8"
            rx="2"
            fill="none"
            stroke={active ? '#c9d8ff' : 'rgb(159 176 216 / 0.7)'}
          />
          <text x="54" y={top + 14.5} class:list={['ill__label', { 'ill__label--strong': active }]}>
            {label}
          </text>
        </g>
      );
    })
  }
  <text x="34" y="322" class="ill__label ill__label--dim">DEVICE</text>
  <circle cx="38" cy="338" r="3" fill="#34d399"></circle>
  <text x="48" y="341" class="ill__label ill__label--strong">Ready</text>

  <!-- Toolbar -->
  <rect x="148" y="62" width="66" height="22" rx="11" fill="#2f52cc"></rect>
  <path d="M162 68.5v9l7.5-4.5Z" fill="#fff"></path>
  <text x="176" y="76.5" class="ill__label ill__label--strong">Run</text>
  <rect x="222" y="62" width="66" height="22" rx="11" fill="none" stroke="rgb(255 255 255 / 0.22)"></rect>
  <rect x="236" y="69" width="8" height="8" rx="1.5" fill="#9fb0d8"></rect>
  <text x="250" y="76.5" class="ill__label">Stop</text>
  <text x="304" y="76.5" class="ill__label ill__label--dim">CYCLE 2 / 3</text>
  <rect x="444" y="62" width="84" height="22" rx="11" fill="none" stroke="rgb(255 255 255 / 0.22)"></rect>
  <text x="486" y="76.5" text-anchor="middle" class="ill__label">Export CSV</text>

  <!-- Chart -->
  <rect x="148" y="96" width="380" height="182" rx="10" fill="#050d29" stroke="rgb(255 255 255 / 0.08)"></rect>
  <g stroke="rgb(255 255 255 / 0.05)">
    {[-30, -20, -10, 10, 20, 30].map((i) => <line x1={box.x0} y1={y(i)} x2={box.x1} y2={y(i)} />)}
    {[-0.2, 0, 0.2, 0.4, 0.6].map((e) => <line x1={x(e)} y1={box.y0} x2={x(e)} y2={box.y1} />)}
  </g>
  <line x1={box.x0} y1={y(0)} x2={box.x1} y2={y(0)} stroke="rgb(159 176 216 / 0.4)" stroke-dasharray="3 4"></line>
  <text x="158" y="112" class="ill__label ill__label--dim">I / µA</text>
  <text x={box.x1} y="270" text-anchor="end" class="ill__label ill__label--dim">E / V</text>
  <path d={curve} fill="rgb(65 105 225 / 0.14)" stroke="#5ad1ff" stroke-width="2" stroke-linejoin="round"></path>
  <circle cx={x(points[54].e)} cy={y(points[54].i)} r="4" fill="#fff" stroke="#5ad1ff" stroke-width="2"></circle>

  <!-- Data table -->
  <g class="ill__label ill__label--dim">
    <text x="156" y="300">t / s</text>
    <text x="256" y="300">E / V</text>
    <text x="356" y="300">I / µA</text>
  </g>
  <path d="M148 307H528" stroke="rgb(255 255 255 / 0.08)"></path>
  {
    rows.map((r, k) => (
      <g class="ill__label">
        <text x="156" y={324 + k * 15}>{r.t}</text>
        <text x="256" y={324 + k * 15}>{r.e}</text>
        <text x="356" y={324 + k * 15} class:list={[{ 'ill__label--strong': k === rows.length - 1 }]}>
          {r.i}
        </text>
      </g>
    ))
  }
</svg>
